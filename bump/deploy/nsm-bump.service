[Unit]
Description=NodeShift Music bump matcher
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/nsm-bump
Environment=NSM_BUMP_HOST=127.0.0.1
Environment=NSM_BUMP_PORT=8097
Environment=NSM_ART_DIR=/var/lib/nsm-bump/art
ExecStart=/opt/nsm-bump/venv/bin/python /opt/nsm-bump/nsm_bump.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=192M
TasksMax=64
StateDirectory=nsm-bump

[Install]
WantedBy=multi-user.target
